@page
@model ForgotPasswordModel
@{
    Layout = "~/Views/Shared/Auth.cshtml";
}

<div class="col-form">
    <div class="box-title-col-form pb-2">
        <h3 class="pb-2">Esqueci minha senha</h3>
        <p>Esqueceu sua senha? Não se preocupe, basta colocar seu e-mail para recuperar sua senha.</p>
        <p class="text-danger">Atenção: Essa funcionalidade só está disponível para contas locais. Se você possui uma conta ALES, contacte o administrador do domínio.</p>
    </div>

    <div class="box-col-form-inner">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group input-login-send">
                <label>E-mail</label>
                <input asp-for="Input.Email" class="form-control" placeholder="Digite seu e-mail" aria-required="true" />
                <img src="~/imgs/login-email.svg" alt="">
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="box-btn">
                <button class="btn btn-primary">Enviar Email</button>
            </div>
            <div class="box-forgot">
                <a class="" asp-page="./ResetPassword">Já tenho um código</a>
            </div>
            <div class="box-forgot">
                <a class="" asp-page="./Login">Voltar para login</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
