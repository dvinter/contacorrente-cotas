@page
@model ChangePasswordModel
@{
    Layout = "~/Views/Shared/Auth.cshtml";
    ViewData["Title"] = "Alterar senha";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<partial name="_StatusMessage" for="StatusMessage" />

<form class="w-100 "  id="change-password-form" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row align-items-end">
        <div class ="form-group ">

            <label for="inputEmail4">Senha atual *</label>
            <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Senha atual" />
            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
        </div>
        <div class="form-group ">

            <label for="inputEmail4">Nova senha *</label>
            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Nova senha"  />
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">

            <label for="inputEmail4">Confirme sua nova senha  *</label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirme sua nova senha " />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
    </div>
    <div class="row align-items-end">
        <div class="col-6  mb-3">
            <button class="btn btn-primary w-100">Salvar</button>
        </div>
        <div class="col-6 mb-3">
            <button onclick="location.href='@Url.Action("Index", "Home")'" type="button" class="btn btn-primary w-100 btn-primary-outline">Voltar</button>
        </div>
    </div>
</form>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
