@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Redefinição de senha";
    Layout = "~/Views/Shared/Auth.cshtml";
}

<div class="row">
    <h1>@ViewData["Title"]</h1>
    <p>
        Verifique seu e-mail para criar uma nova senha.
    </p>
    <div class="box-forgot">
        <a class="" asp-page="./ResetPassword">Recebi o código</a>
    </div>
    <div class="box-forgot">
        <a class="" asp-page="./ForgotPassword">Requisitar outro código</a>
    </div>
</div>