@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Nova Senha";
    Layout = "~/Views/Shared/Auth.cshtml";
}

@*<h1>@ViewData["Title"]</h1>*@

<div class="col-form">
    <div class="box-title-col-form pb-2">
        <h3 class="pb-2">Redefinição de Senha</h3>

    </div>
    <div class="box-col-form-inner">
        @if (Model.InvalidToken && Model.Attempts > 0)
        {
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </form>
            <a asp-page="./Login">Voltar</a>
            <a asp-page="./ResetPassword">Tentar novamente</a>
        }
        else if (Model.InvalidToken && Model.Attempts == 0)
        {
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </form>
            <a asp-page="./Login">Voltar</a>
        }
        else
        {
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group input-login">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-group input-login">
                <label asp-for="Input.Code" class="form-label"></label>
                <input asp-for="Input.Code" type="text" class="form-control" aria-required="true" />
                <span asp-validation-for="Input.Code" class="text-danger"></span>
            </div>
            <div class="form-group input-login">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-group input-login">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="box-btn">
                <button type="submit" class="w-100 btn btn-lg btn-primary">Salvar</button>
            </div>
        </form>
        }
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
