@using AlesCotas.Application.Dto
@using AlesCotas.Domain.Entities
@using System.Globalization;

@model Solicitacao
@{
    Layout = "~/Views/Shared/_LayoutBlank.cshtml";
    ViewData["Title"] = "Recibo - Solicitação " + Model.Numero;
    var grupos = Model.Campos.OrderBy(x => x.Ordem).Select(x => x.Grupo).Distinct();
    ProdutoTipoDto produtoTipo = ViewBag.produtoTipo;
    var currentStatus = Model.Historico.OrderBy(x => x.Sequencia).LastOrDefault();
    CultureInfo ptBr = new CultureInfo("pt-BR");
}

<section id="approvedwithouttable">
    @*<span class="line"></span>*@
    <div class="box-form mt-2">
        <div class="box-form-content">
            <div class="col-one">
                <div class="">
                    <div class="modal-header pb-1 mb-1">
                        <h5 class="modal-title">@Model.Gabinete.Name</h5>
                    </div>
                    <div class="modal-body">
                        <div class="box-title mb-1">
                            <p>Data: <span>@Model.DataSolicitacao.ToShortDateString()</span></p>
                            <!--variavel razor-->
                            <h4 class="pt-1 mb-0">Solicitação de @produtoTipo.Name</h4>
                            <p>@Model.Observacoes</p>
                            <div class="box-solitacao-modal">
                                <p class="py-2">
                                    N° da solicitação: <span> @Model.Numero</span>
                                </p>
                            </div>
                        </div>
                        <div class="box-description-modal mb-3">
                            @foreach (var grupo in grupos)
                            {
                                <h6 class="px-2"> @grupo </h6>

                                @foreach (var item in Model.Campos.OrderBy(x => x.Ordem))
                                {
                                    if (item.Grupo == grupo)
                                    {
                                        <div class="linha-item linha-recibo-text ">
                                            <p>@item.Name:</p>

                                            @if (item.TipoCampo == AlesCotas.Domain.Enum.ETipoCampo.SimNao)
                                            {
                                                <p>@(item.BoolValor ? "Sim" : "Não")</p>
                                            }
                                            else if (item.TipoCampo == AlesCotas.Domain.Enum.ETipoCampo.Data)
                                            {
                                                <p>@(item.DateTimeValor.HasValue ? item.DateTimeValor.Value.ToString("dd/MM/yyyy", ptBr) : item.Valor)</p>
                                            }
                                            else if (item.TipoCampo == AlesCotas.Domain.Enum.ETipoCampo.DataHora)
                                            {
                                                <p>@(item.DateTimeValor.HasValue ? item.DateTimeValor.Value.ToString("dd/MM/yyyy HH:mm", ptBr) : item.Valor)</p>
                                            }
                                            else if (item.TipoCampo == AlesCotas.Domain.Enum.ETipoCampo.Moeda)
                                            {
                                                <p>@(decimal.TryParse(item.Valor, out decimal d) ? d.ToString("C2",ptBr) : item.Valor)</p>
                                            }
                                            else if (item.TipoCampo == AlesCotas.Domain.Enum.ETipoCampo.NumeroDecimal)
                                            {
                                                <p>@(decimal.TryParse(item.Valor, out decimal d) ? d.ToString("N2", ptBr) : item.Valor)</p>
                                            }
                                            else
                                            {
                                                <p>@item.Valor</p>
                                            }

                                        </div>

                                    }
                                }



                            }
                            @if (produtoTipo.HabilitaAnexos && Model.Anexos.Count >0)
                            {
                                <div class="linha-item">
                                    <div class="linha-item-texto">
                                        <h6>Anexos</h6>
                                        <div class="linha-item-texto-inner">
                                            @foreach (var item in Model.Anexos)
                                            {
                                                <p>
                                                    <b>Arquivo:</b> @item.Name |
                                                    <b>Data:</b> @item.DataArquivo |
                                                    <b>Tamanho:</b> @item.Tamanho
                                                </p>
                                            }

                                        </div>
                                    </div>
                                </div>
                            }
                            @* @if (Model.Items.Count > 0)
                            {
                            <div class="linha-item">
                            <div class="linha-item-texto">
                            <h5 style="font-size:17px">Lista de itens</h5>
                            <div class="linha-item-texto-inner">
                            @foreach (var item in Model.Items)
                            {
                            <p>
                            <b>Item:</b> @item.Produto.Name |
                            <b>Quantidade Solicitada:</b> @item.QuantidadeSolicitada |
                            <b>Valor médio (Un):</b> @item.Valor.ToString("C2") |
                            <b>Valor total:</b> @(
                            (item.Valor * item.QuantidadeSolicitada).ToString("C2")
                            )
                            </p>
                            }

                            </div>
                            </div>
                            </div>
                            }*@
                            @if (Model.Items.Count > 0)
                            {
                                <hr style="margin-bottom:0px" />
                                <div>
                                    <div>
                                        <table class="table table-striped  table-hove align-middle ">
                                            <thead class="table-recibo-header">
                                                <tr>
                                                    <th scope="col" class="p0">Item</th>
                                                    <th scope="col" class="p0" width="90px">Unid.</th>
                                                    <th scope="col" class="p0" width="100px">Qtd. @(produtoTipo.ImprimirConferencia? "Solicitada" : "")  </th>

                                                    @*<th scope="col">Valor (Un)</th>*@
                                                    <th scope="col" class="p0"  width="150px">Valor Total</th>
                                                    @if (produtoTipo.ImprimirConferencia)
                                                    {
                                                        <th scope="col" class="p0" width="150px">Qtd. Entregue</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.Items)
                                                {
                                                    <tr>
                                                        <td>@item.Produto.Name</td>
                                                        <td>@item.Produto.Unidade</td>
                                                        <td class="table-recibo-col-num">@item.QuantidadeSolicitada.ToString("N2",ptBr)</td>
                                                        @if (produtoTipo.HabilitaValoresDolar)
                                                        {
                                                            @* <td>US$ @item.Valor.ToString("N2",ptBr)</td>*@
                                                            <td class="table-recibo-col-num">US$ @((item.Valor * item.QuantidadeSolicitada).ToString("N2", ptBr))</td>
                                                        }
                                                        else
                                                        {
                                                            @* <td>@item.Valor.ToString("C2",ptBr)</td>*@
                                                            <td class="table-recibo-col-num">@((item.Valor * item.QuantidadeSolicitada).ToString("C2", ptBr))</td>
                                                        }
                                                        @if (produtoTipo.ImprimirConferencia)
                                                        {
                                                            <td></td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>

                                    </div>
                                </div>
                            }

                            <div class="linha-item linha-recibo-text pt-3">
                                <p>Total Solicitado</p>
                                <p id="totalSolicitacao" class="text-total-solicitacao">@Model.Total.ToString("C2",ptBr)</p>
                            </div>
                            @if (produtoTipo.HabilitaValoresDolar)
                            {
                                <div class="linha-item  linha-recibo-text">
                                    <p>Total em US$: Cotação @Model.CotacaoDolar.ToString("N2",ptBr) em @(Model.DataCotacao?.ToString("dd/MM/yyyy", ptBr) ?? Model.DataSolicitacao.ToString("dd/MM/yyyy", ptBr))</p>
                                    <p id="TotalDolar">US$ @Model.TotalDolar.ToString("N2",ptBr)</p>
                                    @*<input id="cotacao" type="number" asp-for="@Model.TotalDolar" class="form-control" value="0" disabled>*@
                                </div>
                            }

                            

                        </div>
                        <div class=" d-flex justify-content-around pt-5">
                            
                            @if (produtoTipo.ImprimirConferencia)
                            {
                                <p style="font-size:13px; min-width:30%; max-width:40%" class="linha-recibo d-inline-block py-1 px-5 text-center "><i>Solicitante</i></p>
                                <p style="font-size:13px; min-width:30%; max-width:40%" class="linha-recibo d-inline-block py-1 px-5 text-center ps-3"><i>Recebedor</i></p>
                            }
                            else
                            {
                                <p style="font-size:13px; min-width:50%; max-width:90%" class="linha-recibo d-inline-block py-1 px-5 text-center "><i>Solicitante</i></p>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

