                                <label>Selecione um item</label>
                                <select id="itemSelecionado" class="form-select copy"
                                     asp-for="Items[0].ProdutoId"  asp-items="@(new SelectList(ViewBag.Itens, "Id", "Name"))" onchange="onSelectChange()"></select>

                            </div>


                            <div class="form-group mb-3 col-12 col-md-12 col-lg-12 col-xl-4">
                                <label id="labelQtd">Quantidade</label>
                                <input id="qtd" type="number" asp-for="Items[0].QuantidadeSolicitada"
                                       class="form-control" value="1" placeholder="0" step="@(produtoTipo.IncrementoQuantidade)"
                                       onkeypress="preventNonNumericalInput(event)"
                                       oninput="calcularTotal()" />
                            </div>
                            <div class="form-group mb-3 col-6 col-md-6 col-lg-6 col-xl-3">


                                <label>Valor Unitário @(produtoTipo.HabilitaValoresDolar ? "US$" : "R$")</label>
                                <input asp-for="Items[0].Valor" type="number" class="form-control" id="valorUnitario" oninput="calcularTotal()" step="0.01" readonly />@* disabled="@produtoTipo.HabilitaValoresDolar" />*@
                            </div>
                            <div class="form-group mb-3 col-6 col-md-6 col-lg-6 col-xl-3">
                                <label>Valor Total @(produtoTipo.HabilitaValoresDolar ? "US$" : "R$")</label>
                                <input type="number" class="form-control" id="valorTotal" oninput="calcularQuantidade()" onblur="arredondaTotal()" readonly="@produtoTipo.HabilitaValoresDolar" />
                            </div>
                            <span asp-validation-for="Items" class="text-danger"></span>
                        </div>
                    }
                    else
                    {

                    <div class="row">
                        <div class="form-group mb-3 col-12">
                            <label>Selecione um item</label>
                            <select id="itemSelecionado" class="form-select copy"
                                    asp-items="@(new SelectList(ViewBag.Itens, "Id", "Name"))" onchange="onSelectChange()"></select>

                        </div>


                        <div class="form-group mb-3 col-12 col-md-12 col-lg-12 col-xl-4">
                            <label id="labelQtd">Quantidade</label>
                            <input id="qtd" type="number" step="@(produtoTipo.IncrementoQuantidade)"
                                   class="form-control" value="1" placeholder="0"
                                   onkeypress="preventNonNumericalInput(event)"
                                   oninput="calcularTotal()" />
                        </div>
                        <div class="form-group mb-3 col-6 col-md-6 col-lg-6 col-xl-3">
                            <label>Valor Unitário @(produtoTipo.HabilitaValoresDolar ? "US$" : "R$")</label>
                            <input type="number" class="form-control" id="valorUnitario" oninput="calcularTotal()" step="0.01" readonly />@* disabled="@produtoTipo.HabilitaValoresDolar" />*@
                        </div>
                        <div class="form-group mb-3 col-6 col-md-6 col-lg-6 col-xl-3">
                            <label>Valor Total @(produtoTipo.HabilitaValoresDolar ? "US$" : "R$")</label>
                                <input type="number" class="form-control" id="valorTotal" oninput="calcularQuantidade()" onblur="arredondaTotal()" readonly="@produtoTipo.HabilitaValoresDolar" />
                        </div>
                        <div class="box-btn-add col-12 col-md-12 col-lg-2">
                            <button id="btnAdd" type="button" class="btn-entidde-add btn-add">
                                <div class="line-vertical"></div>
                                <div class="line-horizontal"></div>
                            </button>
                        </div>

                        <div id="lista" class="mb-3 row row-cols-2 listar">
                            <!--Lista-->
                        </div>

                        <span asp-validation-for="Items" class="text-danger"></span>
                    </div>
                    }

