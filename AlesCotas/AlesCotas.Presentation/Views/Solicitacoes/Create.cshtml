                                            else if (Model.Campos[i].TipoCampo == ETipoCampo.SimNao)
                                            {
                                                <div class="form-group mb-3 col-12 @("col-md-"+Model.Campos[i].Largura)">

                                                    @*<input type="checkbox" asp-for="Solicitacao.Campos[i].BoolValor" class="form-control" />*@
                                                    @Html.CheckBoxFor(m => m.Campos[i].BoolValor)  <label for="">@Model.Campos[i].Name</label>
                                                    <span asp-validation-for="Campos[i].Valor" class="text-danger"></span>
                                                </div>
                                            }
                                            else if (Model.Campos[i].TipoCampo == ETipoCampo.ListaOpcoes)
                                            {
                                                <div class="mb-3 col-12 @("col-md-"+Model.Campos[i].Largura)">
                                                    <label class="form-check-label" for="">@Model.Campos[i].Name</label>

                                                    <div class="d-flex ">
                                                        @if (Model.Campos[i].Opcoes != null)
                                                        {
                                                            @foreach (var p in Model.Campos[i].Opcoes?.Split(','))
                                                            {
                                                                @if (Model.Campos[i].Obrigatorio)
                                                                {
                                                                    @if (String.IsNullOrWhiteSpace(Model.Campos[i].Valor))
                                                                        Model.Campos[i].Valor = p;
                                                                }
                                                                <div class="form-check col-4">

                                                                    @Html.RadioButtonFor(m => m.Campos[i].Valor, p, new { @class="form-check-input"  } )<label class="form-check-label" for="flexRadioDefault2">
                                                                        @p
                                                                    </label>

                                                                </div>
                                                            }
                                                        }

                                                    </div>
                                                    <span asp-validation-for="Campos[i].Valor" class="text-danger"></span>
                                                </div>
                                            }

                                        }
                                    }
                                </div>
                            </div>
                        }
                    }

                    <hr />
                    @if (produtoTipo.HabilitaAnexos)
                    {
                        <div class="row">
                             <div class="form-group mb-4">
                                    <label for="inputEmail4">Anexos</label>
                                @Html.TextBoxFor(model => model.FileAnexo, new { multiple="multiple", type = "file", @class = "form-control form-control-file" })
                                    @* <input placeholder="Adicione um arquivo anexo" asp-for="FileAnexo" class="form-control" type="file" />*@
                             </div>
                            <hr />
                            <div class="box-table">
                                <div class="table-responsive">
                                    <span class="box-sub-title">Anexos</span>
                                    <table class="table table-striped  table-hove align-middle " id="tableAnexos">
                                        <thead>
                                            <tr>
                                                <th scope="col">Arquivo</th>
                                                <th scope="col">Data</th>
                                                <th scope="col">Tamanho</th>
                                                <th scope="col"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            
                                            @for (int i = 0; i< Model.Anexos.Count ; i++)
                                            {
                                                <tr>
                                                    <input type="hidden" asp-for="@Model.Anexos[i].Id">
                                                    <input id="@("nomeAnexo"+i)" type="hidden" asp-for="@Model.Anexos[i].Name">
                                                    <input type="hidden" asp-for="@Model.Anexos[i].Tamanho">
                                                    <input type="hidden" asp-for="@Model.Anexos[i].SolicitacaoId">
                                                    <input type="hidden" asp-for="@Model.Anexos[i].Extensao">
                                                    <input type="hidden" asp-for="@Model.Anexos[i].DataArquivo">

                                                    <td>@Model.Anexos[i].Name</td>
                                                    <td>@Model.Anexos[i].DataArquivo</td>
                                                    <td>@Model.Anexos[i].Tamanho</td>
                                                    <td>
                                                        <a class="btn btn-primary-outline" asp-area="" asp-controller="Solicitacoes" asp-action="AnexoDownload" asp-route-anexo="@Model.Anexos[i].Id">
                                                            Download
                                                        </a>
                                                        <button type="button" class="btn btn-danger" onclick="deleteAnexo(this,'@("nomeAnexo"+i)')">X</button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>

                                </div>
                            </div>

                        </div>
                        <hr />
                    }

                    <div class="form-group mb-4">
                        <label for="inputEmail4">Observações</label>
                        <textarea placeholder="Adicione uma observação" asp-for="Observacoes" class="form-control" cols="30"
                                  rows="5"></textarea>
                        <span asp-validation-for="Observacoes" class="text-danger"></span>
                    </div>
                    <hr />
                    <div class="form-group mb-4">
                        <label for="inputEmail4">Justificativa</label>
                        <textarea required placeholder="Justificativa de alterações" asp-for="NovaJustificativa" class="form-control" cols="30" rows="5"></textarea>
                        <span asp-validation-for="NovaJustificativa" class="text-danger"></span>
                    </div>

                    @if (perfil.PermiteAprovar  && produtoTipo.PermitirRecorrencia)
                    {
                        <hr />
                        <div class="row">
                        <div class="form-group mb-3 col-6 col-md-4 col-lg-3">
                            @Html.CheckBoxFor(m => m.AprovacaoAutomatica)
                            <label for="inputEmail4">Aprovação Automática</label>
                        </div>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="AprovacaoAutomatica" />
                        @if (Model.AprovacaoAutomatica)
                        {
                            <span>Esta solicitação está com aprovação automática, se for alterada será necessário aprovar novamente.</span>
                        }
                    }


                    <hr />
                    <div class="row">
                        @if (produtoTipo.HabilitaValoresDolar)
                        {
                            <div class="form-group mb-3 col-12 col-lg-3">
                                <label id=labelDolar>Total US$</label>
                                <input id="totalDolar" readonly type="number" step="0.01" class="form-control" style="text-align:right;" />

                                <input type="date" hidden asp-for="DataCotacao" id="dataCotacao" />
                            </div>

                            <div class="form-group mb-3 col-12 col-lg-3">
                                <label id=labelDolar data-toggle="tooltip" title="Data Cotação: (@Model.DataCotacao?.ToShortDateString())">Cotação</label>
                                <input type="number" class="form-control" step="0.01" asp-for="CotacaoDolar" id="cotacaoDolar" oninput="calcularCotacaoPorDolar()" style="text-align:right;" />
                            </div>
                        }

                        <div class="form-group mb-3 col-12 col-lg-3">
                            <label for="">Total R$</label>
                            <input name="Total" id="totalSolicitacao" type="number" step="0.01" class="form-control" oninput="calcularCotacaoPorTotal()" style="text-align:right;" readonly="@(!produtoTipo.HabilitaValoresDolar)" />
                            @*@Html.TextBoxFor(m => m.Solicitacao.Total, new { @class="form-control text-right", @id="totalSolicitacao", @oninput="calcularCotacao()"})*@
                            @*<input data-val-number-decimal-separator="," id="totalSolicitacao" type="number" step="0.01" asp-for="Solicitacao.Total" class="form-control" />*@
                        </div>
                    </div>
                    <div class="btn-request-form pt-4">
                        <button type="submit" class="btn btn-primary">@(editMode ? "Salvar" : "Cadastrar")</button>
                        <button onclick="location.href='@Url.Action("Index", "Solicitacoes", new { ProdutoTipoId=produtoTipo.Id })'" type="button" class="btn btn-primary btn-primary-outline">Voltar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>


@section Scripts {


    <script>

        $(document).ready(function () {



