@using AlesCotas.Application.Dto
@using AlesCotas.Application.Models
@using AlesCotas.Domain.Entities
@using AlesCotas.Domain.Enum
@using AlesCotas.Infra.CrossCutting.Utils.Extensions
@model Solicitacao
@{
    bool editMode = Model?.Id > 0;
    Usuario user = ViewBag.user;
    ProdutoTipoDto produtoTipo = ViewBag.produtoTipo;
    Model.ProdutoTipoId = produtoTipo.Id;
    IEnumerable<ProdutoDto> itens = ViewBag.itens;
    ViewData["Title"] = (editMode ? "Editar" : "Nova") + " Solicitação de " + produtoTipo?.Name;
    GabineteDto gabinete = ViewBag.gabinete;
    var currentStatus = Model.Historico.OrderBy(x => x.Sequencia).LastOrDefault();
    ProdutoTipoUsuarioPerfilDto perfil = produtoTipo.Usuarios.FirstOrDefault(x => x.Perfil.Equals(user.Role));

    int novoStatus = Model.Historico.Count();
    Model.Historico.Add(new SolicitacaoHistorico { DataRegistro = DateTime.Now });


     @if (produtoTipo.PermitirApenasUmItem && Model.Items.Count <=0)
    {
        Model.Items.Add(new SolicitacaoItem { });
    }


}
<style>
    .chosen-container {
        width: 100% !important;
    }

    .box-btn-add {
        display: flex;
        align-items: center;
    }    

    .chosen-container-multi .chosen-choices {
        border-radius: 0.5rem !important;
        padding: .375rem 2.25rem .375rem .75rem;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.5;
    }

</style>
<section class="request-form">
    <div class="back-btn">
        <button type="button" onclick="location.href='@Url.Action("Index", "Solicitacoes", new { ProdutoTipoId=produtoTipo.Id })'"><img src="~/imgs/arrow.svg" alt="" srcset=""></button>
        <h4>@ViewData["Title"]</h4>
    </div>
    <span class="line"></span>
    <div class="box-form">
        <div class="box-form-content">
            <div class="col-one">

                <div class="box-title mb-3">

                    <p>@(gabinete.Name)</p>
                    <p>Saldo: @(gabinete.SaldoDisponivel?.ToString("N2"))</p>

                </div>



                <form asp-action="Save" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ProdutoTipoId" />
                    <input type="hidden" asp-for="GabineteId" />

                    <div class="box-title mb-3">
                        <div class="box-solitacao-modal pt-2">
                            <p>
                                <small class="text-muted">Data da Solicitação: </small>@Model.DataSolicitacao.ToShortDateString()
                            </p>
                        </div>
                        <div class="box-solitacao-modal pt-2">
                            <p>
                                <small class="text-muted">N° da solicitação: </small>@Model.Numero
                            </p>
                        </div>
                        <div class="box-solitacao-modal pt-2">
                            <p>
                                <small class="text-muted">Observações: </small>@Model.Observacoes
                            </p>
                        </div>
                    </div>

                    @if (Model.Campos.Where(x => x.Posicao == 0).Count() > 0)
                    {
                        @foreach (var group in Model.Campos.Where(x => x.Posicao == 0).Select(x => x.Grupo).Distinct())
                        {
                            <hr />
                            <h6>@group</h6>
                            <div class="">
                                <div class="row">
                                    @for (int i = 0; i < Model.Campos.Count; i++)
                                    {
                                        @if (Model.Campos[i].Grupo == group && Model.Campos[i].Posicao == 0)
                                        {

                                            <input type="hidden" asp-for="Campos[i].TipoCampo" />
                                            @if (!String.IsNullOrWhiteSpace(Model.Campos[i].Opcoes))
                                            {
                                                <input type="hidden" asp-for="Campos[i].Opcoes" />
                                            }
                                            <input type="hidden" asp-for="Campos[i].Grupo" />
                                            <input type="hidden" asp-for="Campos[i].Name" />
                                            <input type="hidden" asp-for="Campos[i].Ordem" />
                                            <input type="hidden" asp-for="Campos[i].Largura" />
                                            <input type="hidden" asp-for="Campos[i].Obrigatorio" />
                                            <input type="hidden" asp-for="Campos[i].Posicao" />

                                            @if (Model.Campos[i].TipoCampo == ETipoCampo.ListaSuspensa)
                                            {
                                                <div class="form-group mb-3 col-12 @("col-md-"+Model.Campos[i].Largura)">
                                                    <label for="">@Model.Campos[i].Name</label>
                                                    <select asp-for="Campos[i].Valor" class="form-select">
                                                        <option value="" selected>[Selecione uma opção]</option>
                                                        @foreach (var p in Model.Campos[i].Opcoes.Split(','))
                                                        {
                                                            <option value="@p">@p</option>
                                                        }
                                                    </select>
                                                    <span asp-validation-for="Campos[i].Valor" class="text-danger"></span>
                                                </div>
                                            }
                                            else if (Model.Campos[i].TipoCampo == ETipoCampo.TextoLongo)
                                            {
                                                <div class="mb-3  col-12 @("col-md-"+Model.Campos[i].Largura)">
                                                    <label for="">@Model.Campos[i].Name</label>
                                                    <textarea asp-for="Campos[i].Valor" class="form-control"
                                          rows="5"></textarea>
                                                    <span asp-validation-for="Campos[i].Valor" class="text-danger"></span>
                                                </div>
                                            }
                                            else if (Model.Campos[i].TipoCampo == ETipoCampo.TextoSimples)
                                            {
                                                <div class="mb-3  col-12 @("col-md-"+Model.Campos[i].Largura)">
                                                    <label for="">@Model.Campos[i].Name</label>
                                                    <input type="text" asp-for="Campos[i].Valor" class="form-control" />
                                                    <span asp-validation-for="Campos[i].Valor" class="text-danger"></span>
                                                </div>
                                            }
                                            else if (Model.Campos[i].TipoCampo == ETipoCampo.DataHora)
                                            {
                                                <div class="mb-3  col-12 @("col-md-"+Model.Campos[i].Largura)">
                                                    <label class="control-label">@Model.Campos[i].Name</label>
                                                    <input type="datetime-local" asp-for="Campos[i].DateTimeValor" class="form-control" />
                                                    <span asp-validation-for="Campos[i].Valor" class="text-danger"></span>
                                                </div>
                                            }
                                            else if (Model.Campos[i].TipoCampo == ETipoCampo.Data)
                                            {
                                                <div class="mb-3  col-12 @("col-md-"+Model.Campos[i].Largura)">
                                                    <label for="">@Model.Campos[i].Name</label>
                                                    <input type="date" asp-for="Campos[i].Valor" class="form-control" />
                                                    <span asp-validation-for="Campos[i].Valor" class="text-danger"></span>
                                                </div>
                                            }
                                            else if (Model.Campos[i].TipoCampo == ETipoCampo.IntervaloDatas || Model.Campos[i].TipoCampo == ETipoCampo.IntervaloDatasHoras)
                                            {
                                                <div class="form-row form-inline d-inline-flex mb-3 col-12 ">
                                                    <div class="form-group col-5">
                                                        <label class="control-label text-nowrap">@Model.Campos[i].Name</label>
                                                        <input type="@(Model.Campos[i].TipoCampo == ETipoCampo.IntervaloDatas ? "date" : "datetime-local")" asp-for="Campos[i].IntervaloDatas[0]" max="@(Model.Campos[i].IntervaloDatas[1].HasValue ? Model.Campos[i].IntervaloDatas[1].Value.ToString("yyyy-MM-dd") : "" )" class="form-control" id="@(Model.Campos[i].Name+"_inicio")" onchange="periodoTexto('@Model.Campos[i].Name');setMinDataFinal('@Model.Campos[i].Name')" />
                                                        <span asp-validation-for="Campos[i].Valor" class="text-danger"></span>
                                                    </div>
                                                    <div class="form-group col-1 ms-3 me-3">
                                                        <label class="control-label text-nowrap"> </label>
                                                        <span class="form-control border-0 text-center"> a </span>
                                                    </div>
                                                    <div class="form-group col-5">
                                                        <label class="control-label text-nowrap"> </label>
                                                        <input type="@(Model.Campos[i].TipoCampo == ETipoCampo.IntervaloDatas ? "date" : "datetime-local")" asp-for="Campos[i].IntervaloDatas[1]" min="@(Model.Campos[i].IntervaloDatas[0].HasValue ? Model.Campos[i].IntervaloDatas[0].Value.ToString("yyyy-MM-dd") : "" )" class="form-control" id="@(Model.Campos[i].Name+"_fim")" onchange="periodoTexto('@Model.Campos[i].Name');setMaxDataInicial('@Model.Campos[i].Name')" />
                                                        <span asp-validation-for="Campos[i].Valor" class="text-danger"></span>
                                                    </div>
                                                    <div class="form-group col-1 ms-3 me-3">
                                                        <label class="control-label text-nowrap"> </label>
                                                        <span id="@(Model.Campos[i].Name + "_dias")" class="form-control border-0  text-muted"></span>
                                                    </div>
                                                </div>
                                            }
                                            else if (Model.Campos[i].TipoCampo == ETipoCampo.NumeroInteiro)
                                            {
                                                <div class="mb-3  col-12 @("col-md-"+Model.Campos[i].Largura)">
                                                    <label for="">@Model.Campos[i].Name</label>
                                                    <input type="number" asp-for="Campos[i].Valor" class="form-control" />
                                                    <span asp-validation-for="Campos[i].Valor" class="text-danger"></span>
                                                </div>
                                            }
                                            else if (Model.Campos[i].TipoCampo == ETipoCampo.NumeroDecimal)
                                            {
                                                <div class="mb-3  col-12 @("col-md-"+Model.Campos[i].Largura)">
                                                    <label for="">@Model.Campos[i].Name</label>
                                                    <input type="number" step="0.01" asp-for="Campos[i].Valor" class="form-control" />
                                                    <span asp-validation-for="Campos[i].Valor" class="text-danger"></span>
                                                </div>
                                            }
                                            else if (Model.Campos[i].TipoCampo == ETipoCampo.Moeda)
                                            {
                                                <div class="mb-3  col-12 @("col-md-"+Model.Campos[i].Largura)">
                                                    <label for="">@Model.Campos[i].Name (R$)</label>
                                                    <input type="number" step="0.01" asp-for="Campos[i].Valor" class="form-control" />
                                                    <span asp-validation-for="Campos[i].Valor" class="text-danger"></span>
                                                </div>
                                            }
                                            else if (Model.Campos[i].TipoCampo == ETipoCampo.SimNao)
                                            {
                                                <div class="form-group mb-3 col-12 @("col-md-"+Model.Campos[i].Largura)">

                                                    @*<input type="checkbox" asp-for="Solicitacao.Campos[i].BoolValor" class="form-control" />*@
                                                    @Html.CheckBoxFor(m => m.Campos[i].BoolValor)  <label for="">@Model.Campos[i].Name</label>
                                                    <span asp-validation-for="Campos[i].Valor" class="text-danger"></span>
                                                </div>
                                            }
                                            else if (Model.Campos[i].TipoCampo == ETipoCampo.ListaOpcoes)
                                            {
                                                <div class="mb-3 col-12 @("col-md-"+Model.Campos[i].Largura)">
                                                    <label class="form-check-label" for="">@Model.Campos[i].Name</label>

                                                    <div class="d-flex ">
                                                        @if (Model.Campos[i].Opcoes != null)
                                                        {
                                                            @foreach (var p in Model.Campos[i].Opcoes?.Split(','))
                                                            {
                                                                @if (Model.Campos[i].Obrigatorio)
                                                                {
                                                                    @if (String.IsNullOrWhiteSpace(Model.Campos[i].Valor))
                                                                        Model.Campos[i].Valor = p;
                                                                }
                                                                <div class="form-check col-4">

                                                                    @Html.RadioButtonFor(m => m.Campos[i].Valor, p, new { @class="form-check-input"  } )<label class="form-check-label" for="flexRadioDefault2">
                                                                        @p
                                                                    </label>

                                                                </div>
                                                            }
                                                        }

                                                    </div>
                                                    <span asp-validation-for="Campos[i].Valor" class="text-danger"></span>
                                                </div>
                                            }

                                        }
                                    }
                                </div>
                            </div>
                        }
                    }
                    <hr />

                    @*<div class="form-group mb-3 col-12 col-md-12 col-lg-5">
                    <label for="inputEmail4">Itens</label><br />
                    <select class="form-select chosen" multiple aria-label="Itens">
                    @foreach (var p in itens)
                    {
                    <option value="@p.Id">@p.Name</option>
