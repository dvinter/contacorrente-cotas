                $(".movecontainer").append(chosenHtml);
                $(".chosen").chosen();

            });
        });

        $('.Gabinetes').click(function () {
            //$('ul').html("");
            $("#Gabinetes").each(function () {
                if ($(this).is(":checked")) {

                }
            });
        });

        // Array de items
        const items = [];




        // Produtos
        const produtos = @Html.Raw(Json.Serialize(ViewBag.Itens));


        // Botão adicionar
        const btnAdd = document.getElementById("btnAdd");

        // Lista
        const lista = document.getElementById("lista");
        // Inputs
        const select = document.getElementById("itemSelecionado");
        const quantidade = document.getElementById("qtd");
        const valorUnitario = document.getElementById("valorUnitario");
        const valorTotal = document.getElementById("valorTotal");
        const totalSolicitacao = document.getElementById("totalSolicitacao");
        const elementCotacao = document.getElementById("cotacaoDolar");
        const labelQtd = document.getElementById("labelQtd");



        function deleteAnexo(r,id)
        {
           var i = r.parentNode.parentNode.rowIndex;
           r.parentNode.parentNode.hidden = true;
           //document.getElementById("tableAnexos").deleteRow(i);
           document.getElementById(id).value = null;
        }


        const model = @Html.Raw(Json.Serialize(Model));

        if (elementCotacao)
        {if (model.cotacaoDolar <= 0) {
            GetCotacao().then(value => {
                $('#labelDolar').text("Total em US$ Cotado à " + value?.cotacao?.toFixed(2) + " em " + value?.dataStr);
                elementCotacao.value = value?.cotacao?.toFixed(2);
                $('#dataCotacao').val(value?.data);
            });
        }
        }

        
        const prodTipo = @Html.Raw(Json.Serialize(produtoTipo));


      


        if (!prodTipo.permitirApenasUmItem)
       {
        model.items.forEach(x => items.push({ Id: x.produtoId, ValorUnitario: x.valor, QuantidadeSolicitada: x.quantidadeSolicitada, Name: x.produto.name }))
        atualizarLista();
         btnAdd.addEventListener('click', (e) => {
            //console.log("Ola mundo", select.options[select.selectedIndex].innerHTML, select.options[select.selectedIndex].value, quantidade.value);
            addItem();
            e.stopPropagation();
        });
       }
          else
        {
           
                valorUnitario.value = model.items[0].valor;
                quantidade.value =  model.items[0].quantidadeSolicitada;
                valorTotal.value =  (quantidade.value * valorUnitario.value).toFixed(2);
                valorTotal.setAttribute("step", @(produtoTipo.IncrementoQuantidade) * valorUnitario.value);

               
            console.log(model);
        }



        $('#totalSolicitacao').val(model.total);
        calcularCotacao();
        // Campo valor medio
        //const valorMedio = document.getElementById("valorMedio");

       

        function calcularTotal() {

            const total = ((quantidade.value * valorUnitario.value) * 1.0).toFixed(2);// produtos.find(p => p.id === parseInt(select.options[select.selectedIndex].value)).valor;
            valorTotal.value = total;
            valorTotal.setAttribute("step", @(produtoTipo.IncrementoQuantidade) * valorUnitario.value);
            //console.log(valorTotal.value);
            //calcularCotacao();
        @(produtoTipo.PermitirApenasUmItem ? "atualizaTotalSolicitacao(total);" : "");
        }
        function calcularQuantidade() {

            const total = (valorTotal.value * 1.0).toFixed(2);
            const qtd = total / valorUnitario.value;
            quantidade.value = qtd.toFixed(2);
            //const total = quantidade.value * valorUnitario.value;// produtos.find(p => p.id === parseInt(select.options[select.selectedIndex].value)).valor;
            //= total.toFixed(2);
            //console.log(valorTotal.value);
            //calcularCotacao();
               @(produtoTipo.PermitirApenasUmItem ? "atualizaTotalSolicitacao(total);" : "");
        }

        function addItem() {

            if (quantidade.value <= 0) {
                infoSwal("Insira um valor valido para quantidade");
                return;
            }

            if (items.findIndex(i => i.id == parseInt(select.options[select.selectedIndex].value)) != -1) {
                var index = items.findIndex(i => i.id == parseInt(select.options[select.selectedIndex].value));

                items[index].QuantidadeSolicitada += parseInt(quantidade.value);
                atualizarLista();
                return;
            }

            items.push({
                Id: parseInt(select.options[select.selectedIndex].value),
                Name: select.options[select.selectedIndex].innerHTML,
                QuantidadeSolicitada: quantidade.value,
                ValorUnitario: valorUnitario.value
            });

            atualizarLista();
            calcularCotacao();

            //console.log(produtos);
        };

        function calcularCotacao() {

            //const totalDolar = $('#totalDolar').val();
            //if (totalDolar > 0) {

            //    let totalSolicitacao = $('#totalSolicitacao').val();
            //    const cotacao = totalSolicitacao / totalDolar;
            //    elementCotacao.value = cotacao;

            //    //const cotacao = elementCotacao.value;


            //    //let totalSolicitacao = $('#totalSolicitacao').val();
            //    //totalSolicitacao = totalSolicitacao.replace(",", ".");
            //    //let totalDolar = totalSolicitacao / cotacao;
            //    //////console.log(totalDolar);
            //    //$('#totalDolar').val(totalDolar.toFixed(2));
            //}

            if (elementCotacao && elementCotacao.value > 0) {
                const cotacao = elementCotacao.value;


                let totalSolicitacao = $('#totalSolicitacao').val();
                totalSolicitacao = totalSolicitacao.replace(",", ".");
                let totalDolar = totalSolicitacao / cotacao;
                ////console.log(totalDolar);
                $('#totalDolar').val(totalDolar.toFixed(2));
            }
        }
        function calcularCotacaoPorTotal() {

            const totalDolar = $('#totalDolar').val();
            if (totalDolar && totalDolar > 0) {
                let totalSolicitacao = $('#totalSolicitacao').val();
                elementCotacao.value = (totalSolicitacao / totalDolar).toFixed(2);
            }

            //totalSolicitacao = totalSolicitacao.replace(",", ".");
            //let totalDolar = totalSolicitacao / cotacao;
            //////console.log(totalDolar);
            //$('#totalDolar').val(totalDolar.toFixed(2));

        }
        function calcularCotacaoPorDolar() {
            if (elementCotacao && elementCotacao.value > 0) {
                const cotacao = elementCotacao.value;
                let totalSolicitacao = $('#totalDolar').val();
                totalSolicitacao = totalSolicitacao.replace(",", ".");
                let totalDolar = totalSolicitacao * cotacao;
                ////console.log(totalDolar);
                $('#totalSolicitacao').val(totalDolar.toFixed(2));
            }
        }

        function deletarItem(index) {
            //console.log(items.length);
            items.splice(index, 1);
            atualizarLista();
        }

        function atualizarLista() {
            lista.innerHTML = '';
            var total = 0;
            //console.log(items)
            var idx = 0;
            for (item of items) {
                total += (item.ValorUnitario * item.QuantidadeSolicitada);
                lista.innerHTML += `
                                                                                                <div class="col col-md-12 col-lg-12 col-xl-6 col-12 my-2 fadeIn">
                                                                                                    <div class="box-itens-selected ">
                                                                                                           <input type="hidden" name="Items[${idx}].ProdutoId" value="${item.Id}" />
                                                                                                                   <input type="hidden" name="Items[${idx}].Valor" value="${item.ValorUnitario}" />
                                                                                                                           <input type="hidden" name="Items[${idx}].QuantidadeSolicitada" value="${item.QuantidadeSolicitada}" />
                                                                                                                           <input type="hidden" name="Items[${idx}].Produto.Name" value="${item.Name}" />
                                                                                                            <p>
                                                                                                                <b>Item: </b> ${item.Name} -
                                                                                                                    <b>Qtd: </b>${item.QuantidadeSolicitada} -
                                                                                                                        <b>Custo:</b><span>${(item.ValorUnitario * item.QuantidadeSolicitada).toFixed(2) } </span>
                                                                                                            </p>
                                                                                                        <span class="btn-delete">
                                                                                                            <svg width="18" height="20" viewBox="0 0 18 20" fill="none"
                                                                                                                xmlns="http://www.w3.org/2000/svg">
                                                                                                                <path
                                                                                                                    d="M1 4.5C0.447715 4.5 0 4.94772 0 5.5C0 6.05228 0.447715 6.5 1 6.5L1 4.5ZM17 6.5C17.5523 6.5 18 6.05228 18 5.5C18 4.94772 17.5523 4.5 17 4.5V6.5ZM6 16.5C6 17.0523 6.44772 17.5 7 17.5C7.55228 17.5 8 17.0523 8 16.5H6ZM8 9C8 8.44772 7.55228 8 7 8C6.44772 8 6 8.44772 6 9H8ZM10 16.5C10 17.0523 10.4477 17.5 11 17.5C11.5523 17.5 12 17.0523 12 16.5H10ZM12 9C12 8.44772 11.5523 8 11 8C10.4477 8 10 8.44772 10 9H12ZM2.5 5.5L2.5 17H4.5L4.5 5.5L2.5 5.5ZM5.5 20L12.5 20V18L5.5 18V20ZM15.5 17L15.5 5.5L13.5 5.5L13.5 17H15.5ZM3.5 4.5H1L1 6.5H3.5L3.5 4.5ZM14.5 6.5L17 6.5V4.5L14.5 4.5V6.5ZM5 4.5H3.5L3.5 6.5L5 6.5V4.5ZM6 5.5L6 3L4 3L4 5.5H6ZM7 2L11 2V0L7 0V2ZM14.5 4.5H13V6.5H14.5V4.5ZM13 4.5L5 4.5V6.5L13 6.5V4.5ZM12 3V5.5H14V3H12ZM8 16.5L8 9H6L6 16.5H8ZM12 16.5V9H10V16.5H12ZM11 2C11.5523 2 12 2.44772 12 3H14C14 1.34315 12.6569 0 11 0V2ZM6 3C6 2.44772 6.44772 2 7 2V0C5.34315 0 4 1.34315 4 3L6 3ZM12.5 20C14.1569 20 15.5 18.6569 15.5 17H13.5C13.5 17.5523 13.0523 18 12.5 18V20ZM2.5 17C2.5 18.6569 3.84315 20 5.5 20V18C4.94772 18 4.5 17.5523 4.5 17H2.5Z"
                                                                                                                    fill="#676D85" />
                                                                                                            </svg>
                                                                                                        </span>
                                                                                                    </div>
                                                                                                </div>`
                idx++;
            }


            //const cotacao = elementCotacao ? elementCotacao.value : 1;
            //console.log(cotacao);
            //totalSolicitacao.value = (total  @(produtoTipo.HabilitaValoresDolar ? "* cotacao" : "")).toFixed(2);
             atualizaTotalSolicitacao(total);

            //console.log(total)
            refreshDelete();
        }


        function arredondaTotal() {
            const qtd = quantidade.value * 1.0;
            const total = ((qtd.toFixed(2) * valorUnitario.value) * 1.0).toFixed(2);
            valorTotal.value = total;

        @(produtoTipo.PermitirApenasUmItem ? "atualizaTotalSolicitacao(total);" : "");
        }

        function atualizaTotalSolicitacao(total){
            const cotacao = elementCotacao ? elementCotacao.value : 1;
            //console.log(cotacao);
            totalSolicitacao.value = ((total  @(produtoTipo.HabilitaValoresDolar ? "* cotacao" : "")) * 1.0).toFixed(2);
       }

        function refreshDelete() {
            btnDelete = document.querySelectorAll('.btn-delete')
            btnDelete.forEach((btn, index) => {
                btn.addEventListener("click", (e) => {
                    deletarItem(index);
                    e.stopPropagation();
                })
            })
        }

        function onSelectChange() {
            console.log('ansduidasodnbasuidnasiodjasiodjasiodjasiodj')
            const produto = produtos.find(p => p.id === parseInt(select.options[select.selectedIndex].value));

            const valorUnitarioItem = produto.valor;
            //valorMedio.value = formatter.format(valorUnitario);
            valorUnitario.value = valorUnitarioItem.toFixed(2);// formatter.format(valorUnitarioItem);
            labelQtd.innerText = "Quantidade " + (produto.unidade ? "(" + produto.unidade.toUpperCase() + ")" : "");
            valorUnitario.readOnly = valorUnitario.value > 0;
            if (!prodTipo.calcularDiarias && !prodTipo.permitirApenasUmItem) {
                quantidade.value = 1;
            }

            calcularTotal();
        }


        setTimeout(() => {
              if (!prodTipo.permitirApenasUmItem || valorUnitario.value <= 0 )
            {
            onSelectChange();
            }
        }, 100);



        function setMinDataFinal(nomeCampo) {
            const dtinicio = document.getElementById(nomeCampo + "_inicio");
            const dtifim = document.getElementById(nomeCampo + "_fim");

            dtifim.setAttribute("min", dtinicio.value);


        }
        function setMaxDataInicial(nomeCampo) {
            const dtinicio = document.getElementById(nomeCampo + "_inicio");
            const dtifim = document.getElementById(nomeCampo + "_fim");

            dtinicio.setAttribute("max", dtifim.value)

        }
        function periodoTexto(nomeCampo) {
            //POG - calcular quantidade de diárias
            if (prodTipo.calcularDiarias) {
                var data1 = new Date(document.getElementById(nomeCampo + "_inicio").value);
                var data2 = new Date(document.getElementById(nomeCampo + "_fim").value);
                var xdtinicio = new Date(document.getElementById(nomeCampo + "_inicio").value);
                var xdtfim = new Date(document.getElementById(nomeCampo + "_fim").value);

                data1.setHours(0, 0, 0, 0);
                data2.setHours(0, 0, 0, 0);
                var diferencaMilissegundos = Math.abs(data2 - data1);
                var diferencaDias = Math.ceil(diferencaMilissegundos / (1000 * 60 * 60 * 24));


                const diffInMs = (xdtfim - xdtinicio);
                var diferencaHoras = diffInMs / (1000 * 60 * 60);

                if (diferencaDias <= 0) {
                    if (diferencaHoras >= 6)
                        quantidade.value = 0.5;
                    else
                        quantidade.value = 0;
                }
                else {
                    if (xdtfim.getHours() >= 12) {
                        quantidade.value = (diferencaDias + 0.5);
                    }
                    else {
                        quantidade.value = diferencaDias;
                    }
                }

                calcularTotal();

            }
        }

    </script>
}
