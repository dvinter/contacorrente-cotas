@using AlesCotas.Application.Classes
@using AlesCotas.Application.Dto
@using AlesCotas.Application.Filter
@using AlesCotas.Application.Filter.Base
@using AlesCotas.Domain.Entities
@using AlesCotas.Domain.Enum

@model ListaPaginada<SolicitacaoAdiantamentoCotaDto>

@{
    ViewData["Title"] ="Solicitações de Adiantamento de Cotas Parlamentares";
    SolicitacaoAdiantamentoCotaFilter filtro = ViewBag.filtro;
    Usuario usuario = ViewBag.user;
    List<GabineteDto> gabinetes = ViewBag.gabinetes;

    if (usuario.GabineteId.HasValue)
    {
        filtro.GabineteId = usuario.GabineteId.Value;
    }

    //--bs-gutter-x: 1.5rem;
}

<section class="section-table">
    <div class="box-title">
        <div class="back-btn">
            <button type="button" onclick="location.href='@Url.Action("SelectTipos", "Solicitacoes")'"><img src="~/imgs/arrow.svg" alt="" srcset=""></button>
            <h4 class="d-none d-lg-block">@ViewData["Title"]</h4>
        </div>

        <div class="box-btn-to-edit">
            <button onclick="location.href='@Url.Action("New")'" type="button" class="btn btn-primary px-4 py-2">
                Nova Solicitação
            </button>
        </div>
    </div>
    <span class="line"></span>
    <div class="box-form">
        <div class="box-form-content">
            <div class="box-content-title mb-3">
                <div class="box-text mb-3">
                    <img src="~/imgs/side-request.svg" alt="">
                    <h4>Lista de Solicitações de Adiantamento de Cotas Parlamentares</h4>
                </div>
                <form asp-action="Index" class="w-100 ">
                    <div class="row align-items-end">
                        <div class="form-group mb-3 w-100 col-12 col-md-4 col-lg-4">
                            <label for="inputEmail4">Gabinete</label>
                            <select class="form-select" aria-label="Filtro Gabinete" asp-for="@filtro.GabineteId" name="GabineteId" disabled="@(usuario.Role == EUsuarioPerfil.Gabinete)">
                                <option>[Selecione um Gabinete]</option>
                                @foreach (GabineteDto gabinete in gabinetes)
                                {
                                    <option value="@gabinete.Id">@gabinete.Name</option>
                                }
                            </select>
                        </div>
                       @* <div class="form-group mb-3 col-12 col-md-12 col-lg-4">
                            <label for="inputEmail4">Filtro</label>
                            <input type="text" class="form-control  " id="inputEmail4" asp-for="@filtro.FilterText" name="FilterText"
                                   placeholder="Digite para pesquisar">
                        </div>*@
                        <div class="form-group mb-3 col-12 col-md-12  col-lg-12 col-xl-3">
                            <label for="inputEmail4">Status</label>
                            <select class="form-select" aria-label="Filtro Status" asp-for="@filtro.Status" name="Status">
                                <option value="0">Todos</option>
                                <option value="1">Em Aberto</option>
                                <option value="2">Respondidas</option>
                            </select>
                        </div>
                        <div class="form-group mb-3 col-12 col-md-12 col-lg-12 col-xl-3">
                            <label for="inputEmail4">Data Inicial</label>
                            <input type="date" class="form-control" asp-for="@filtro.DataInicial" name="DataInicial" placeholder="">
                        </div>
                        <div class="form-group mb-3 col-12  col-lg-12 col-md-12 col-xl-3">
                            <label for="inputEmail4">Data Final</label>
                            <input type="date" class="form-control" asp-for="@filtro.DataFinal" name="DataFinal" placeholder="">
                        </div>
                        <div class="col-12 col-md-12  col-lg-12 col-xl-3 mb-3">
                            <button class="btn btn-primary w-100">Buscar</button>
                        </div>
                    </div>

                </form>
            </div>
            <div class="box-table">
                <div style="margin-bottom: 1rem;" class="table-responsive ">
                    <table class="table table-striped  table-hove align-middle ">
                        <thead>
                            <tr>
                                <th style="min-width: 160px" scope="col">Data Solicitação</th>
                                <th scope="col">Gabinete</th>
                                <th style="min-width: 160px" scope="col">Mês Referência</th>
                                <th scope="col">Descrição</th>
                                <th style="min-width: 160px" scope="col">Data Resposta</th>
                                <th style="min-width: 160px" scope="col">Usuário Resposta</th>
                                <th style="min-width: 180px" scope="col">Última Atualização</th>
                                <th style="min-width: 180px" scope="col">Status</th>
                                <th scope="col">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.DataSolicitacao)</td>
                                    <td>@Html.DisplayFor(modelItem => item.GabineteNome)</td>
                                    <td>@Html.DisplayFor(modelItem => item.MesReferente)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Descricao)</td>
                                    <td>@Html.DisplayFor(modelItem => item.DataResposta)</td>
                                    <td>@Html.DisplayFor(modelItem => item.UsuarioRespostaNome)</td>
                                    <td>@Html.DisplayFor(modelItem => item.UltimaAtualizacao)</td>
                                    <td>@Html.DisplayFor(modelItem => item.StatusDescription)</td>
                                   <td style="width:100px ;">
                                        <div class="btns-table-action">
                                         
                                            @if (usuario.Role == AlesCotas.Domain.Enum.EUsuarioPerfil.Administrador)
                                            {
                                                @if (!item.DataResposta.HasValue)
                                                {
                                                    <button onclick="approve(@item.Id)" class="btn-approve">
                                                      @* <a asp-action="Aprovar" asp-route-id="@item.Id">*@
                                                            <img src="~/imgs/validar.svg" alt="">
                                                       @* </a>*@
                                                    </button>
                                                    <button onclick="reject(@item.Id)" class="btn-disapproved">
                                                       @* <a asp-action="Recusar" asp-route-id="@item.Id">*@
                                                            <img src="~/imgs/close.svg" alt="">
                                                       @* </a>*@
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>

                            }


                        </tbody>
                    </table>
                </div>
              
                <div class="footer-table">
                    <div>
                        <p>Total de produtos: @Model.Count de @Model.TotalRegistros</p>
                    </div>
                    <nav aria-label="Page navigation example">
                        <ul class="pagination">

                            <li class="page-item @(Model.TemAnterior? "" : "disabled")">
                                <a class="page-link"
                                   asp-route-filter.DataInicial="@filtro.DataInicial" asp-route-filter.DataFinal="@filtro.DataFinal"
                                asp-route-filter.FilterText="@filtro.FilterText" asp-route-filter.Status="@filtro.Status" asp-route-filter.PageNumber=@(Model.PaginaAtual-1) aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>

                            @for (var i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(Model.PaginaAtual == i ? "active" : "")">
                                    <a class="page-link"
                                   asp-route-filter.DataInicial="@filtro.DataInicial" asp-route-filter.DataFinal="@filtro.DataFinal"
                                    asp-route-filter.FilterText="@filtro.FilterText" asp-route-filter.Status="@filtro.Status" asp-route-filter.PageNumber=@i>@(i)</a>
                                </li>
                            }

                            <li class="page-item @(Model.TemProxima? "" : "disabled")">
                                <a class="page-link"
                                   asp-route-filter.DataInicial="@filtro.DataInicial" asp-route-filter.DataFinal="@filtro.DataFinal"
                                asp-route-filter.FilterText="@filtro.FilterText" asp-route-filter.Status="@filtro.Status" asp-route-filter.PageNumber=@(Model.PaginaAtual+1) aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</section>



<script>
     function approve(id) {
        confirmSwal('Aprovar Solicitação', 'Esta operação não poderá ser desfeita').then(result => {
            switch (result.isConfirmed) {
                case true:
                    window.location.replace(`SolicitacaoAdiantamentoCotas/Aprovar/${id}`);
                    console.log('aprovada')
                    break;
                case false:
                    console.log('Cancela')
                    break;
                default:
                // code block
            }

        })
    }
    function reject(id) {
        confirmSwal('Recusar Solicitação', 'Esta operação não poderá ser desfeita!').then(result => {
            switch (result.isConfirmed) {
                case true:
                    window.location.replace(`SolicitacaoAdiantamentoCotas/Recusar/${id}`);
                    console.log('recusada')
                    break;
                case false:
                    console.log('Cancela')
                    break;
                default:
                // code block
            }

        })
    }

    //function refreshUser() {
    //    refersh('Alterar status', 'Está operação poderá ser desfeita!').then(result => {
    //        switch (result.isConfirmed) {
    //            case true:
    //                console.log('Deletado')
    //                break;
    //            case false:
    //                console.log('Cancelado')
    //                break;
    //            default:
    //            // code block
    //        }

    //    })
    //}
</script>
