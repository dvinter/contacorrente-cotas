    <script src="~/js/toastr.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)


    <script>

        const toast =  @Html.Raw(Json.Serialize(toast));;

        if (toast.info)
        {
            infoSwal(toast.info);
        }
        if (toast.error)
        {
            errorSwal(toast.error);
        }
        if (toast.success) 
        {
            successSwal(toast.success);
        }

        </script>


