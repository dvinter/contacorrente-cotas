@using AlesCotas.Application.Dto
@using AlesCotas.Domain.Entities
@using AlesCotas.Domain.Enum
@using AlesCotas.Infra.CrossCutting.Utils.Extensions
@model Parlamentar
@{
    bool editMode = Model?.Id > 0;
    ViewData["Title"] = (editMode ? "Editar" : "Novo") +  " Parlamentar";
}

<section class="edit-form">
    <div class="back-btn">
        <button type="button" onclick="location.href='@Url.Action("Index")'"><img src="~/imgs/arrow.svg" alt="" srcset=""></button>
        <h4>@ViewData["Title"]</h4>
    </div>
    <span class="line"></span>
    <div class="box-form">
        <div class="box-form-content">
            <div class="col-one">
                <form asp-action="Save" >
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <div class="row">
                        <div class="form-group mb-3 col-12 col-md-12 col-lg-12">
                            <label for="inputEmail4">Nome</label>
                            <input asp-for="Name" type="text" class="form-control" placeholder="Nome">
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group mb-3 col-12 col-md-12 col-lg-12">
                            <label for="inputEmail4">Matrícula</label>
                            <input asp-for="Matricula" type="text" class="form-control" placeholder="Código interno ALES">
                        </div>
                    </div>
                    
                    <div class="form-group form-check">
                        <label class="form-check-label">
                            <input class="form-check-input" asp-for="Ativo" /> @Html.DisplayNameFor(model => model.Ativo)
                        </label>
                    </div>
                    <hr />
       
                    <div class="btn-request-form pt-4">
                        <button type="submit" class="btn btn-primary">@(editMode ? "Salvar" : "Cadastrar")</button>
                        <button onclick="location.href='@Url.Action("Index")'" type="button" class="btn btn-primary btn-primary-outline">Voltar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
 
</script>